{#
  Renders a single multi-row INSERT statement (one VALUES tuple per generated
  row) instead of repeating the INSERT INTO clause per row. `columns` is the
  ordered list of column names; `rows` is a matching list of already-SQL-literal
  value lists (quoting/escaping happens in mock_generator.py, not here).

  `identity_columns` lists the (physical) column names generated with
  explicit, database-assigned-looking values (auto-increment/IDENTITY
  primary keys). `dialect` (one of `sqlserver`, `postgres`, `oracle`, or
  unset/None) picks the directive needed to allow inserting explicit values
  into such columns; engines that accept explicit identity values without
  any extra syntax (mysql, snowflake, databricks, trino, clickhouse, ...)
  leave `dialect` unset and get a plain INSERT statement.
#}
-- Mock data for {{ table_name }}
-- Generated by `datacontract mock` ({{ rows | length }} row{{ '' if rows | length == 1 else 's' }})
{% if identity_columns and dialect == 'sqlserver' %}
SET IDENTITY_INSERT {{ table_name }} ON;
{% endif %}
INSERT INTO {{ table_name }} ({{ columns | join(', ') }})
{% if identity_columns and dialect in ('postgres', 'oracle') %}
OVERRIDING SYSTEM VALUE
{% endif %}
VALUES
{% for row in rows %}
    ({{ row | join(', ') }}){{ ',' if not loop.last else ';' }}
{% endfor %}
{% if identity_columns and dialect == 'sqlserver' %}
SET IDENTITY_INSERT {{ table_name }} OFF;
{% endif %}
{% if identity_columns and dialect == 'postgres' %}
{% for column in identity_columns %}
SELECT setval(pg_get_serial_sequence('{{ table_name }}', '{{ column }}'), (SELECT MAX({{ column }}) FROM {{ table_name }}));
{% endfor %}
{% endif %}
