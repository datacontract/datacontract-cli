{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "id"],
  "properties": {
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "logicalType": { "type": "string" },
                "quality": { "type": "array" }
              },
              "unevaluatedProperties": false
            }
          }
        }
      }
    }
  }
}
